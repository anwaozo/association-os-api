# --- Database (Supabase) ---------------------------------------------------
# Runtime: Supabase "Transaction pooler" connection string (port 6543)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres"
# Migrations: Supabase "Direct connection" or "Session pooler" string (port 5432)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# --- Auth -------------------------------------------------------------------
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# --- Web --------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API (wildcard subdomains OK)
CORS_ORIGINS="http://localhost:3000,https://*.netlify.app"

# --- Optional ---------------------------------------------------------------
# PORT=4000
# DB_POOL_MAX=10            # defaults to 1 on Netlify/Lambda, 10 elsewhere
# DB_SSL=auto             # TLS to the database: auto (on for Supabase/Neon/RDS), true, false
# RATE_LIMIT_MAX=300        # requests per IP per 15 minutes
# BULK_IMPORT_MAX=250       # people per import request
# SEED_PASSWORD=""          # password for demo accounts created by `npm run db:seed`
# SEED_PLATFORM_EMAIL=""    # platform admin created by the seed
