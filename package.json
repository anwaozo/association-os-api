   "license": "ISC",
   "dependencies": {
      "@prisma/adapter-pg": "^6.19.0",
      "@prisma/client": "^6.19.0",
      "bcryptjs": "^3.0.3",
      "cookie-parser": "^1.4.7",
      "cors": "^2.8.5",
      "date-fns": "^4.1.0",
      "dotenv": "^16.4.5",
      "express": "^5.1.0",
      "express-rate-limit": "^8.2.1",
      "helmet": "^8.1.0",
      "jsonwebtoken": "^9.0.2",
      "morgan": "^1.10.1",
      "pg": "^8.23.1",
      "prisma": "^6.19.0",
      "serverless-http": "^4.0.0",
      "slugify": "^1.6.6"
   },
   "devDependencies": {
      "nodemon": "^3.1.7"
   },
