generator client {
  provider   = "prisma-client-js"
  // "client" = Rust-free query compiler + pg driver adapter.
  // No native engine binary to bundle, so the same build runs on
  // Netlify Functions, AWS, Docker, or the Mac Studio servers.
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  // Runtime traffic (Supabase: the pooled connection string, port 6543)
  url       = env("DATABASE_URL")
  // Migrations (Supabase: the direct connection string, port 5432)
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// Every tenant-owned table carries organizationId. The API never queries
// those tables without it (see src/config/db.js -> forTenant()).
// ---------------------------------------------------------------------------

model Organization {
  id                     Int       @id @default(autoincrement())
  name                   String
  slug                   String    @unique
  tagline                String?
  logoUrl                String?
  primaryColor           String?   @default("#1F3864")
  status                 Int       @default(1) // 1 active | 0 suspended | 2 pending approval | 3 rejected
  // Who applied / who the first admin invite goes to
  contactName            String?
  contactEmail           String?
  contactPhone           String?
  approvedAt             DateTime?
  rejectedAt             DateTime?
  rejectionReason        String?
  // Set when the org's first admin finishes the welcome setup
  onboardedAt            DateTime?
  // Stripe Connect (Express). Donations are destination charges to this account.
  stripeAccountId        String?   @unique
  stripeChargesEnabled   Boolean   @default(false)
  stripeDetailsSubmitted Boolean   @default(false)
  // Apperr's cut of each online donation, in percent. 0 = no fee.
  platformFeePercent     Float     @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now()) @updatedAt

  invites           Invite[]
  activities        Activity[]
  messageTemplates  MessageTemplate[]
  messages          Message[]
  messageRecipients MessageRecipient[]
  donations         Donation[]

  users                   User[]
  contacts                Contact[]
  events                  Event[]
  memberships             Membership[]
  rsvps                   Rsvp[]
  campaigns               Campaign[]
  userMembershipHistories UserMembershipHistory[]
}

// Single-use admin invite links. Only a SHA-256 hash of the token is stored;
// the raw link is shown once, when it is generated.
model Invite {
  id             Int       @id @default(autoincrement())
  organizationId Int
  email          String
  name           String?
  role           Int       @default(1)
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  createdById    Int?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model User {
  id                  Int       @id @default(autoincrement())
  organizationId      Int
  name                String?
  // Email stays unique across the platform for now so login needs no org picker.
  email               String    @unique
  phone               String
  password            String
  membershipId        Int?
  role                Int       @default(0) // 1 admin | 2 member | 3 contact
  isPlatformAdmin     Boolean   @default(false) // Apperr staff: can create organizations
  status              Int?      @default(1)
  // Directory profile (filled in by the member under Settings > My Profile)
  title               String?
  company             String?
  location            String?
  about               String?
  website             String?
  linkedin            String?
  tags                String[]  @default([])
  showInDirectory     Boolean   @default(true)
  // Notifications bell: activity newer than this is "unread"
  notificationsSeenAt DateTime?
  createdAt           DateTime  @default(now())

  organization            Organization            @relation(fields: [organizationId], references: [id])
  contacts                Contact[]
  membership              Membership?             @relation("UserMembership", fields: [membershipId], references: [id])
  events                  Event[]                 @relation("UserEvents")
  refreshTokens           RefreshToken[]
  rsvps                   Rsvp[]
  userMembershipHistories UserMembershipHistory[]
  memberships             Membership[]
  donations               Donation[]

  @@unique([organizationId, phone])
  @@index([organizationId])
}

model UserMembershipHistory {
  id             Int       @id @default(autoincrement())
  organizationId Int
  userId         Int
  membershipId   Int
  startDate      DateTime  @default(now())
  endDate        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  membership   Membership   @relation(fields: [membershipId], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId])
}

model Contact {
  id             Int          @id @default(autoincrement())
  organizationId Int
  name           String
  phone          String
  email          String?
  status         Int?         @default(1)
  userId         Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Event {
  id             Int      @id @default(autoincrement())
  organizationId Int
  title          String
  slug           String
  date           DateTime @db.Date
  start_time     String?
  end_time       String?
  location       String?
  capacity       Int?
  price          Float?
  description    String
  isRSVP         Boolean? @default(true)
  isPublic       Boolean? @default(false)
  status         Int?     @default(1)

  createdBy    Int
  organization Organization @relation(fields: [organizationId], references: [id])
  creator      User         @relation("UserEvents", fields: [createdBy], references: [id])
  rsvps        Rsvp[]

  createdAt DateTime @default(now())

  @@unique([organizationId, slug])
  @@index([organizationId, date])
}

model Membership {
  id              Int      @id @default(autoincrement())
  organizationId  Int
  name            String?
  slug            String
  price           Float?
  billing_cadence String?
  benefits        String[]
  auto_renewal    Boolean? @default(false)
  status          Int?     @default(1)
  createdAt       DateTime @default(now())

  createdBy    Int
  organization Organization @relation(fields: [organizationId], references: [id])
  creator      User         @relation(fields: [createdBy], references: [id])

  users                   User[]                  @relation("UserMembership")
  userMembershipHistories UserMembershipHistory[]

  @@unique([organizationId, slug])
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  tokenHash  String   @unique
  userId     Int
  revoked    Boolean  @default(false)
  replacedBy Int?
  expiresAt  DateTime
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}

model Rsvp {
  id             Int      @id @default(autoincrement())
  organizationId Int
  user_id        Int
  event_id       Int
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [user_id], references: [id])
  event        Event        @relation(fields: [event_id], references: [id])

  @@unique([user_id, event_id])
  @@index([organizationId])
}

model Campaign {
  id              Int      @id @default(autoincrement())
  organizationId  Int
  name            String
  slug            String
  goal            Float
  date            DateTime @db.Date
  donation_amount Json?
  capacity        Float
  price           Float?
  description     String
  isCustomAmount  Boolean
  isPublic        Boolean
  isAnonymous     Boolean
  isEmailNotifiy  Boolean
  isRecurring     Boolean
  thank_you       String

  organization Organization @relation(fields: [organizationId], references: [id])
  donations    Donation[]

  createdAt DateTime? @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Notifications: an append-only activity feed per organization.
// type: member_joined | members_imported | event_created | event_rsvp |
//       membership_changed | campaign_created | donation | message_sent
// ---------------------------------------------------------------------------
model Activity {
  id             Int      @id @default(autoincrement())
  organizationId Int
  type           String
  actorId        Int?
  title          String
  detail         String?
  meta           Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
}

// ---------------------------------------------------------------------------
// Messages (email). Sent through Resend when RESEND_API_KEY is set.
// ---------------------------------------------------------------------------
model MessageTemplate {
  id             Int      @id @default(autoincrement())
  organizationId Int
  name           String
  subject        String
  body           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  messages     Message[]

  @@unique([organizationId, name])
}

// status: draft | ready (saved, email not configured yet) | sending | sent | partial | failed
// audienceType: all_members | active_members | tier | event_attendees | custom
model Message {
  id             Int       @id @default(autoincrement())
  organizationId Int
  templateId     Int?
  subject        String
  body           String
  audienceType   String
  audienceRef    Json?
  audienceLabel  String
  status         String    @default("draft")
  recipientCount Int       @default(0)
  sentCount      Int       @default(0)
  failedCount    Int       @default(0)
  createdById    Int?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  template     MessageTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients   MessageRecipient[]

  @@index([organizationId, createdAt])
}

// status: pending | sent | delivered | bounced | failed
model MessageRecipient {
  id             Int       @id @default(autoincrement())
  organizationId Int
  messageId      Int
  userId         Int?
  name           String?
  email          String
  status         String    @default("pending")
  providerId     String?
  error          String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([messageId])
  @@index([providerId])
}

// ---------------------------------------------------------------------------
// Fundraising. Online donations go through Stripe Checkout as destination
// charges to the organization's connected Express account. Admins can also
// record offline gifts (cash, check, other).
// method: stripe | cash | check | other
// status: pending | succeeded | failed | refunded
// ---------------------------------------------------------------------------
model Donation {
  id                    Int       @id @default(autoincrement())
  organizationId        Int
  campaignId            Int?
  userId                Int?
  donorName             String?
  donorEmail            String?
  amountCents           Int
  currency              String    @default("usd")
  method                String
  status                String    @default("pending")
  isAnonymous           Boolean   @default(false)
  note                  String?
  stripeSessionId       String?   @unique
  stripePaymentIntentId String?   @unique
  feeCents              Int       @default(0)
  createdById           Int?
  paidAt                DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([campaignId])
}
