generator client {
  provider   = "prisma-client-js"
  // "client" = Rust-free query compiler + pg driver adapter.
  // No native engine binary to bundle, so the same build runs on
  // Netlify Functions, AWS, Docker, or the Mac Studio servers.
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  // Runtime traffic (Supabase: the pooled connection string, port 6543)
  url       = env("DATABASE_URL")
  // Migrations (Supabase: the direct connection string, port 5432)
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// Every tenant-owned table carries organizationId. The API never queries
// those tables without it (see src/config/db.js -> forTenant()).
// ---------------------------------------------------------------------------

model Organization {
  id           Int      @id @default(autoincrement())
  name         String
  slug         String   @unique
  tagline      String?
  logoUrl      String?
  primaryColor String?  @default("#1F3864")
  status       Int      @default(1) // 1 active | 0 suspended
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  users                   User[]
  contacts                Contact[]
  events                  Event[]
  memberships             Membership[]
  rsvps                   Rsvp[]
  campaigns               Campaign[]
  userMembershipHistories UserMembershipHistory[]
}

model User {
  id              Int      @id @default(autoincrement())
  organizationId  Int
  name            String?
  // Email stays unique across the platform for now so login needs no org picker.
  email           String   @unique
  phone           String
  password        String
  membershipId    Int?
  role            Int      @default(0) // 1 admin | 2 member | 3 contact
  isPlatformAdmin Boolean  @default(false) // Apperr staff: can create organizations
  status          Int?     @default(1)
  createdAt       DateTime @default(now())

  organization            Organization            @relation(fields: [organizationId], references: [id])
  contacts                Contact[]
  membership              Membership?             @relation("UserMembership", fields: [membershipId], references: [id])
  events                  Event[]                 @relation("UserEvents")
  refreshTokens           RefreshToken[]
  rsvps                   Rsvp[]
  userMembershipHistories UserMembershipHistory[]
  memberships             Membership[]

  @@unique([organizationId, phone])
  @@index([organizationId])
}

model UserMembershipHistory {
  id             Int       @id @default(autoincrement())
  organizationId Int
  userId         Int
  membershipId   Int
  startDate      DateTime  @default(now())
  endDate        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  membership   Membership   @relation(fields: [membershipId], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId])
}

model Contact {
  id             Int      @id @default(autoincrement())
  organizationId Int
  name           String
  phone          String
  email          String?
  status         Int?     @default(1)
  userId         Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User     @relation(fields: [userId], references: [id])
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

model Event {
  id             Int      @id @default(autoincrement())
  organizationId Int
  title          String
  slug           String
  date           DateTime @db.Date
  start_time     String?
  end_time       String?
  location       String?
  capacity       Int?
  price          Float?
  description    String
  isRSVP         Boolean? @default(true)
  isPublic       Boolean? @default(false)
  status         Int?     @default(1)

  createdBy    Int
  organization Organization @relation(fields: [organizationId], references: [id])
  creator      User         @relation("UserEvents", fields: [createdBy], references: [id])
  rsvps        Rsvp[]

  createdAt DateTime @default(now())

  @@unique([organizationId, slug])
  @@index([organizationId, date])
}

model Membership {
  id              Int      @id @default(autoincrement())
  organizationId  Int
  name            String?
  slug            String
  price           Float?
  billing_cadence String?
  benefits        String[]
  auto_renewal    Boolean? @default(false)
  status          Int?     @default(1)
  createdAt       DateTime @default(now())

  createdBy    Int
  organization Organization @relation(fields: [organizationId], references: [id])
  creator      User         @relation(fields: [createdBy], references: [id])

  users                   User[]                  @relation("UserMembership")
  userMembershipHistories UserMembershipHistory[]

  @@unique([organizationId, slug])
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  tokenHash  String   @unique
  userId     Int
  revoked    Boolean  @default(false)
  replacedBy Int?
  expiresAt  DateTime
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}

model Rsvp {
  id             Int      @id @default(autoincrement())
  organizationId Int
  user_id        Int
  event_id       Int
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [user_id], references: [id])
  event        Event        @relation(fields: [event_id], references: [id])

  @@unique([user_id, event_id])
  @@index([organizationId])
}

model Campaign {
  id              Int      @id @default(autoincrement())
  organizationId  Int
  name            String
  slug            String
  goal            Float
  date            DateTime @db.Date
  donation_amount Json?
  capacity        Float
  price           Float?
  description     String
  isCustomAmount  Boolean
  isPublic        Boolean
  isAnonymous     Boolean
  isEmailNotifiy  Boolean
  isRecurring     Boolean
  thank_you       String

  organization Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime? @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
}
